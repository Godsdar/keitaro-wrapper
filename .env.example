# Адрес трекера (без /admin) и API-ключ из Keitaro: Профиль → API ключи
KEITARO_URL=https://tlgk.host
KEITARO_API_KEY=

# Префикс для всех создаваемых кампаний
CAMPAIGN_PREFIX=test_familiya_

# Что подставлять в форму создания по умолчанию (ищется по имени)
DEFAULT_DOMAIN=in.posdk.xyz
DEFAULT_GROUP=FORTESTS
DEFAULT_SOURCE=FORTESTS

# Куда первый поток отправляет трафик из выбранных стран
GEO_REDIRECT_URL=https://www.google.com

# SQLite по умолчанию; для PostgreSQL: postgresql+psycopg://user:pass@localhost/keitaro
DATABASE_URL=sqlite:///./keitaro_wrapper.db
